# Server
PORT=4000

# MongoDB connection string. Leave empty in development to fall back to an
# in-memory MongoDB instance (mongodb-memory-server) — data is ephemeral!
MONGODB_URI=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Environment: development | production | test
NODE_ENV=development
